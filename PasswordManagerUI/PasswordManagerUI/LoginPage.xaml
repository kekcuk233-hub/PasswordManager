<Page x:Class="PasswordManagerUI.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Width="320">

            <TextBlock Text="🔐 Password Manager"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Master Password"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <PasswordBox x:Name="MasterPasswordBox"
                         PlaceholderText="Enter master password"
                         KeyDown="OnPasswordBoxKeyDown"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <Button x:Name="LoginButton"
                    Content="Login"
                    HorizontalAlignment="Stretch"
                    Click="OnLoginClick"/>

            <Button x:Name="RegisterButton"
                    Content="Register"
                    HorizontalAlignment="Stretch"
                    Click="OnRegisterClick"/>

        </StackPanel>
    </Grid>
</Page>
